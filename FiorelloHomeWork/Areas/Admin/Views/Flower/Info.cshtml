@model FlowerDetailUIVM



<!-- HEADER END -->
<!-- MAIN START -->

<body>

    <main>

        <!-- PRODUCT TITLE START -->

        <section id="product-title">
            <div class="container">
                <div class="row py-5">
                    <div class="col-12 text-center">
                        <h1>@Model.Title</h1>
                        <i class="text-black-50">
                            <a asp-controller="Home" asp-action="Index" class="text-black-50">Home</a> / Shop / Majesty Palm
                        </i>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRODUCT TITLE END -->
        <!-- PRODUCT DETAIL START -->

        <section id="product-detail">
            <div class="container">
                <div class="row py-5">

                    <!-- Images -->
                    <div class="col-md-6">
                        @foreach (var item in Model.FlowerImages)
                        {
                            @if (item.IsMane)
                            {
                                <div class="main-img">
                                    <img id="main-img" src="~/img/@item.Name" class="img-fluid" alt="">
                                </div>
                            }
                        }
                        
                        <div class="row thumbs mt-3">
                            @foreach (var item in Model.FlowerImages)
                            {
                            
                                <div class="col-3">
                                    <img src="~/img/@item.Name" class="img-fluid thumb active" alt="">
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="col-md-6">
                        <div class="info mt-4 mt-md-0 px-md-3">
                            <h2 id="product-name">@Model.Title</h2>

                            

                            <h3 class="price my-3" id="product-price">$@Model.Price</h3>

                            <p class="short-desc text-black-50">
                                @Model.Description
                            </p>

                            <div class="buy d-flex align-items-center flex-wrap my-4">
                                <div class="quantity d-flex align-items-center mr-3">
                                    <button type="button" id="minus">-</button>
                                    <input type="text" id="qty" value="1" readonly>
                                    <button type="button" id="plus">+</button>
                                </div>
                                <button type="button" class="btn btn-danger btn-lg rounded-0 px-5" id="add-to-cart">
                                    Add to
                                    cart
                                </button>
                            </div>

                            <ul class="meta list-unstyled">
                                <li><span>SKU:</span> <span class="text-black-50" id="product-sku">FR-0013</span></li>
                                <li><span>Category:</span> @Model.CategoryName</li>
                                <li>
                                    <span>Tags:</span> <a href="index.html" class="text-black-50">Palm</a>, <a href="index.html" class="text-black-50">Indoor</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>

                <!-- Tabs -->
                <div class="row pb-5">
                    <div class="col-12">
                        <ul class="nav nav-tabs" id="productTab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="desc-tab" data-toggle="tab" href="#desc" role="tab">Description</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="info-tab" data-toggle="tab" href="#more-info" role="tab">
                                    Additional
                                    information
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="reviews-tab" data-toggle="tab" href="#reviews" role="tab">Reviews (@Model.FlowerComments.Count())</a>
                            </li>
                        </ul>
                        <div class="tab-content py-4">
                            <div class="tab-pane fade show active" id="desc" role="tabpanel">
                                <p>
                                    Nullam dictum felis eu pede mollis pretium. Integer tincidunt. Cras dapibus. Vivamus
                                    elementum semper nisi. Aenean vulputate eleifend tellus. Aenean leo ligula, porttitor
                                    eu, consequat vitae, eleifend ac, enim.
                                </p>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Aenean commodo ligula eget
                                    dolor. Aenean massa. Cum sociis natoque penatibus et magnis dis parturient montes.
                                </p>
                            </div>
                            <div class="tab-pane fade" id="more-info" role="tabpanel">
                                <table class="table table-bordered">
                                    <tbody>
                                        <tr>
                                            <th>Height</th>
                                            <td>80 cm</td>
                                        </tr>
                                        <tr>
                                            <th>Pot</th>
                                            <td>Ceramic, white</td>
                                        </tr>
                                        <tr>
                                            <th>Light</th>
                                            <td>Bright, indirect</td>
                                        </tr>
                                        <tr>
                                            <th>Watering</th>
                                            <td>Once a week</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="tab-pane fade" id="reviews" role="tabpanel">
                                @foreach (var item in Model.FlowerComments)
                                {
                                    <div class="review mb-4">
                                        <h6>@item.FullName</h6>
                                        <div class="rating">
                                            @for (int i = 0; i < item.RateCount; i++)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                        </div>
                                        <p class="text-black-50 mt-2">
                                            @item.Description
                                        </p>
                                    </div>
                                }
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>


        
</body>

<!-- MAIN END -->
<!-- FOOTER START -->
