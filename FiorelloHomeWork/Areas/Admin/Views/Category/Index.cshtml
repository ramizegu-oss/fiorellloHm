@model IEnumerable<CategoryVM>


<div style="text-align: center; margin-top: 15pc;     display: flex;
    justify-content: center;
    flex-direction: column;
    gap: 6pc;">
    <h1>Categories</h1>
    <a asp-action="create" class="btn btn-success" style="    width: 15%;
    margin: 0 auto;">Create</a>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Operatons</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        <form method="post" asp-action="delete" asp-route-id="@item.Id">
                            <button type="submit" class="btn btn-danger">Delete</button>
                            
                        </form>
                        <a asp-action="edit" asp-route-id="@item.Id">Edit</a>
                    
                            
                        
                        

                    </td>
                </tr>
            }
            
        </tbody>
    </table>
</div>